{
  "name": "tree-sitter-twig",
  "version": "1.1.0",
  "description": "Twig grammar for tree-sitter",
  "main": "bindings/node",
  "types": "bindings/node",
  "scripts": {
    "build": "tree-sitter generate && node-gyp build",
    "test": "npm run build && tree-sitter test",
    "install": "node-gyp-build",
    "prebuildify": "prebuildify --napi --strip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbprod/tree-sitter-twig.git"
  },
  "keywords": [
    "parser",
    "twig"
  ],
  "files": [
    "grammar.js",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**"
  ],
  "author": "gbprod <contact@gb-prod.fr>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gbprod/tree-sitter-twig/issues"
  },
  "homepage": "https://github.com/gbprod/tree-sitter-twig#readme",
  "dependencies": {
    "node-addon-api": "^8.0.0",
    "node-gyp-build": "^4.8.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.25.10",
    "prebuildify": "^6.0.0"
  },
  "allowScripts": {
    "tree-sitter-cli@0.25.10": true
  }
}
